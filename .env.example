# Copy to .env and fill in. Nothing here is a real secret.
# If GGOS_API_TOKEN is left empty, the trigger endpoints answer 503
# instead of running — that is intentional, not a bug.

# GGOS_DATA_DIR=/path/to/ggos-repair/data
# GGOS_DB_PATH=/path/to/ggos-repair/data/gangster_god.db
# GGOS_API_TOKEN=
# GGOS_CORS_ORIGINS=https://example.com
# GGOS_OUTBOUND_ENABLED=0

# --- Apollo (prospecting.OS) — fill in .env, never commit it ---
# APOLLO_API_KEY="your_scoped_key_here"
# APOLLO_BASE_URL="https://api.apollo.io/api/v1"
# APOLLO_WEBHOOK_SECRET="whsec_..."
# APOLLO_DAILY_CREDIT_LIMIT=100
# APOLLO_ENRICH_SCORE_THRESHOLD=60
# APOLLO_APPROVAL_REQUIRED=true

# --- Turso (cloud DB for the Vercel webhook) — see docs/turso-setup.md ---
# TURSO_DATABASE_URL="libsql://gangster-god-....turso.io"
# TURSO_AUTH_TOKEN="eyJ..."
